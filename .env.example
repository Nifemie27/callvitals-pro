# Environment variables for `docker compose up`. Copy to .env and fill in
# real secrets before running; docker-compose.yml reads this file
# automatically since it lives next to it.

POSTGRES_USER=callvitals
POSTGRES_PASSWORD=callvitals_dev_password
POSTGRES_DB=callvitals
POSTGRES_PORT=5433

REDIS_PORT=6379

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

BACKEND_PORT=4000
FRONTEND_PORT=8080

# The frontend's public origin. Must match where you access the app from,
# since the backend only accepts credentialed requests from this origin.
CORS_ORIGIN=http://localhost:8080

# Set to true only when serving both frontend and backend over HTTPS.
COOKIE_SECURE=false

# Optional: override the seeded demo accounts' passwords.
# SEED_ADMIN_PASSWORD=
# SEED_ANALYST_PASSWORD=
