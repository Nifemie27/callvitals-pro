# Server
NODE_ENV=development
PORT=4000

# Database (PostgreSQL via Prisma). Local dev points at the Dockerized
# Postgres in docker-compose.yml (host port 5433 to avoid clashing with
# a locally installed Postgres on 5432).
DATABASE_URL=postgresql://callvitals:callvitals_dev_password@localhost:5433/callvitals?schema=public

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=callvitals-pro

# Redis (caching layer)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
CACHE_ANALYTICS_TTL_SECONDS=60
CACHE_CALLS_TTL_SECONDS=30

# CORS — the frontend origin allowed to send credentialed requests
CORS_ORIGIN=http://localhost:5173

# Cookies
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# Request body size limit
BODY_LIMIT=1mb

# Seed script (optional overrides — defaults are used if unset)
# SEED_ADMIN_PASSWORD=
# SEED_ANALYST_PASSWORD=
# SEED_FORCE=1
